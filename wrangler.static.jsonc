/**
 * Static-assets-only deployment.
 *
 * Pairs with `npm run build:static`, which emits real .html into `out/`.
 * There is deliberately no `main` here: with no Worker script, Cloudflare
 * serves every request straight from the assets layer. Your code never runs,
 * so the 10 ms CPU limit and the 100k requests/day cap do not apply, and the
 * whole thing costs nothing.
 *
 * Deploy with:  npx wrangler deploy -c wrangler.static.jsonc
 *
 * `wrangler.jsonc` is the other path — the OpenNext Worker build, for when
 * server-side features (ISR, API routes, the admin panel) are actually needed.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidubuzz",
  "compatibility_date": "2025-03-25",

  "assets": {
    "directory": "./out",

    // We build with `trailingSlash: true`, so every route is a directory with
    // an index.html. auto-trailing-slash resolves /page/5 and /page/5/ to the
    // same file instead of 404ing on one of them.
    "html_handling": "auto-trailing-slash",

    // Serve the prerendered 404 page for unknown paths. Not "single-page-
    // application": this is a multi-page static site and SPA mode would
    // return 200 for every bad URL, which wrecks crawling.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
